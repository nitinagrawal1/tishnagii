# Application Environment Variables
APP_URL="https://tishnagii.com"

# Razorpay server credentials (never expose the secret to browser code)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public browser key used by Vite
VITE_RAZORPAY_KEY_ID=

# Firebase Admin service account JSON (server only; configure in Vercel environment variables)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Public Firebase browser config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
